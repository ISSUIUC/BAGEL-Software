{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32 (ST-LINK)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/MyProject.elf",
      "device": "STM32WB15CC",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32wbx.cfg"
      ],
      "runToEntryPoint": "main",
      "preLaunchTask": "build"
    }
  ]
}